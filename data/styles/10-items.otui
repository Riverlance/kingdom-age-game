Item < UIItem
  size: 34 34
  padding: 1
  image-source: /images/ui/slot/item
  image-clip: 0 0 34 34
  ttf-font: verdanapro-v
  ttf-font-weight: 700
  ttf-font-size: 10
  ttf-stroke: 1 black
  border-color: #faebd5
  color: white

  $on:
    image-source: /images/ui/slot/item_blessed

  $disabled:
    color: #646464

  UIWidget
    id: tier
    size: 10 8
    image-source: /images/inventory/tiers-strip
    image-clip: 0 0 10 8
    image-size: 10 8
    anchors.top: parent.top
    anchors.right: parent.right
    phantom: true
    focusable: false
    visible: false
    image-smooth: true
