TextEdit < UITextEdit
  ttf-font: verdanapro-v
  ttf-font-weight: 900
  ttf-font-size: 11
  letter-spacing: -0.5
  ttf-stroke: 1 #000b
  color: #c9bdab
  size: 86 22
  text-offset: 0 4
  placeholder-color: #707070
  placeholder-offset: 0 1
  opacity: 1
  padding: 4
  image-source: /images/ui/textedit
  image-border: 1
  //selection-color: #111416
  // d8c7a0 264f78
  selection-background-color: #26784f
  $disabled:
    color: #333b43ff
    opacity: 0.5

PasswordTextEdit < TextEdit
  text-hidden: true

MultilineTextEdit < TextEdit
  multiline: true
