TextEdit < UITextEdit
  ttf-font: verdanapro-v
  ttf-font-weight: 700
  ttf-font-size: 11
  color: #c9bdab
  size: 86 22
  text-offset: 0 4
  opacity: 1
  padding: 4
  image-source: /images/ui/textedit
  image-border: 1
  //selection-color: #111416
  // d8c7a0 264f78
  selection-background-color: #26784f
  $disabled:
    color: #333b43ff
    opacity: 0.5

  Label
    id: placeholder
    color: #c9bdab
    opacity: 0.5
    anchors.fill: parent
    text-align: topleft
    text-wrap: true
    phantom: true

PasswordTextEdit < TextEdit
  text-hidden: true

MultilineTextEdit < TextEdit
  multiline: true
