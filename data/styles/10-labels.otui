// For put tooltip on labels, use 'phantom: false' on the label widget

Label < UILabel
  ttf-font: verdanapro-v
  ttf-font-weight: 900
  ttf-font-size: 11
  letter-spacing: -0.5
  ttf-stroke: 1 #000b
  height: 16
  color: #dfdfdf

  $disabled:
    color: #dfdfdf88

FlatLabel < UILabel
  ttf-font: verdanapro-v
  ttf-font-weight: 900
  ttf-font-size: 11
  letter-spacing: -0.5
  ttf-stroke: 1 #000b
  height: 16
  color: #dfdfdf
  size: 86 20
  text-offset: 3 3
  image-source: /images/ui/_background/panel_flat
  image-border: 1

  $disabled:
    color: #dfdfdf88

MenuLabel < Label

ListLabel < UILabel
  ttf-font: verdanapro-v
  ttf-font-weight: 900
  ttf-font-size: 10
  letter-spacing: -0.5
  ttf-stroke: 1 #000b
  height: 16
  color: #dfdfdf

  $disabled:
    color: #dfdfdf88

GameLabel < UILabel
  ttf-font: verdanapro-v
  ttf-font-weight: 900
  ttf-font-size: 10
  letter-spacing: -0.5
  ttf-stroke: 1 #000b
  height: 16
  color: #dfdfdf

  $disabled:
    color: #dfdfdf88
