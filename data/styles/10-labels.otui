// For put tooltip on labels, use 'phantom: false' on the label widget

Label < UILabel
  ttf-font: verdanapro-v
  ttf-font-weight: 700
  ttf-font-size: 11
  height: 16
  color: #dfdfdf

  $disabled:
    color: #dfdfdf88

FlatLabel < UILabel
  ttf-font: verdanapro-v
  ttf-font-weight: 700
  ttf-font-size: 11
  height: 16
  color: #dfdfdf
  size: 86 20
  text-offset: 3 3
  image-source: /images/ui/_background/panel_flat
  image-border: 1

  $disabled:
    color: #dfdfdf88

MenuLabel < Label

GameLabel < UILabel
  ttf-font: verdanapro-v
  ttf-font-weight: 700
  ttf-font-size: 11
  height: 16
  color: #dfdfdf
