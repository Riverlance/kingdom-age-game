Button < UIButton
  ttf-font: verdanapro-v
  ttf-font-weight: 700
  ttf-font-size: 11
  color: #f2af4eff
  size: 80 23
  text-offset: 0 -1
  image-source: /images/ui/_button/default_square
  image-color: #dfdfdf
  image-clip: 0 0 32 21
  image-border: 4
  padding: 5 10 5 10
  opacity: 1.0

  $hover !disabled:
    image-clip: 0 21 32 21

  $pressed:
    image-clip: 0 42 32 21
    //text-offset: 1 1

  $disabled:
    color: #f2af4e88
    opacity: 0.6

TabButton < UIButton
  size: 22 23
  image-source: /images/ui/_button/tab_rounded
  image-color: #dfdfdf
  image-clip: 0 0 260 102
  image-border: 3
  icon-color: #dfdfdf
  color: #dfdfdf

  $hover !on:
    color: #dfdfdf

  $disabled:
    image-color: #dfdfdf66
    icon-color: #dfdfdf

  $on:
    color: #dfdfdf
    image-clip: 0 102 260 102

NextButton < UIButton
  size: 12 21
  image-source: /images/ui/_button/arrow_horizontal
  image-clip: 12 0 12 21
  image-color: #ffffff

  $hover !disabled:
    image-clip: 12 21 12 21

  $pressed:
    image-clip: 12 21 12 21

  $disabled:
    image-color: #dfdfdf88

  $on:
    image-source: /images/ui/_button/arrow_horizontal_on

PreviousButton < UIButton
  size: 12 21
  image-source: /images/ui/_button/arrow_horizontal
  image-clip: 0 0 12 21
  image-color: #ffffff

  $hover !disabled:
    image-clip: 0 21 12 21

  $pressed:
    image-clip: 0 21 12 21

  $disabled:
    image-color: #dfdfdf88

  $on:
    image-source: /images/ui/_button/arrow_horizontal_on

AddButton < UIButton
  size: 20 20
  image-source: /images/ui/icon_add
  image-color: #dfdfdfff

  $hover !disabled:
    image-color: #dfdfdf99

  $pressed:
    image-color: #dfdfdf44

  $disabled:
    image-color: #dfdfdf55

LightButton < Button
  size: 130 21
  image-source: /images/ui/_button/default_rounded
  icon-source: none

  $hover:
    color: #dfdfdfff
    icon-source: /images/ui/_button/light

  $pressed:
    color: #dfdfdfff
    icon-source: /images/ui/_button/light

EmptyMenuButton < UIButton
  id: emptyMenuButton
  size: 14 14
  ttf-font: verdanapro-v
  ttf-font-weight: 700
  ttf-font-size: 11
  text-offset: 0 -1
  color: #bcbcbc
  image-source: /images/ui/_button/mini_window_empty
  image-clip: 0 0 14 14
  icon-size: 14 14
  phantom: false

  $hover:
    image-clip: 0 14 14 14

  $pressed:
    image-clip: 0 28 14 14

MenuButton < EmptyMenuButton
  icon-source: /images/ui/_button/mini_window_icon

MiniWindowMenuButton < EmptyMenuButton
  anchors.verticalCenter: prev.verticalCenter
  anchors.right: prev.outsideLeft
  margin-right: 2
  size: 12 12
  icon-offset: -1 -1

InfoMenuButton < MiniWindowMenuButton
  id: infoButton
  text: ?
  text-align: center
  color: #cdc46c

LockMenuButton < MiniWindowMenuButton
  id: lockButton
  !tooltip: loc'${ClientStylesButtonLockTooltip}'

  icon-source: /images/ui/_button/mini_window_icon
  icon-clip: 84 0 14 14

  $on:
    !tooltip: loc'${ClientStylesButtonUnlockTooltip}'
    icon-clip: 98 0 14 14

BallMenuButton < MiniWindowMenuButton
  id: ballMenuButton

  icon-source: /images/ui/_button/mini_window_icon
  icon-clip: 70 0 14 14

ArrowMenuButton < MiniWindowMenuButton
  id: arrowMenuButton

  icon-source: /images/ui/_button/mini_window_icon
  icon-clip: 56 0 14 14

  $on:
    icon-clip: 42 0 14 14

InvertedArrowMenuButton < ArrowMenuButton
  icon-clip: 42 0 14 14

  $on:
    icon-clip: 56 0 14 14

DownArrowMenuButton < MiniWindowMenuButton
  id: downArrowMenuButton

  icon-source: /images/ui/_button/mini_window_icon
  icon-clip: 56 0 14 14

UpArrowMenuButton < MiniWindowMenuButton
  id: upArrowMenuButton

  icon-source: /images/ui/_button/mini_window_icon
  icon-clip: 42 0 14 14

CloseMenuButton < MiniWindowMenuButton
  id: closeButton

  icon-source: /images/ui/_button/mini_window_icon
  icon-clip: 28 0 14 14

MinimizeMenuButton < MiniWindowMenuButton
  id: minimizeButton
  !tooltip: loc'${ClientStylesButtonMinimizeTooltip}'

  icon-source: /images/ui/_button/mini_window_icon
  icon-clip: 0 0 14 14

  $on:
    !tooltip: loc'${ClientStylesButtonMaximizeTooltip}'
    icon-clip: 14 0 14 14

MoreButton < MiniWindowMenuButton
  id: moreButton
  size: 16 16

  icon-source: /images/ui/_button/mini_window_icon
  icon-clip: 14 0 14 14

LessButton < MiniWindowMenuButton
  id: lessButton
  size: 16 16

  icon-source: /images/ui/_button/mini_window_icon
  icon-clip: 0 0 14 14
