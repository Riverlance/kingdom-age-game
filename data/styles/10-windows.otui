Window < UIWindow
  ttf-font: verdanapro-v
  ttf-font-weight: 700
  ttf-font-size: 11
  size: 200 200
  opacity: 1
  color: #c9bdab
  text-offset: 0 10
  text-align: top
  image-source: /images/ui/_background/window
  image-border: 1
  padding-top: 38
  padding-left: 9
  padding-right: 9
  padding-bottom: 9

  $disabled:
    color: #c9bdab88

  $dragging:
    opacity: 0.9

HeadlessWindow < UIWindow
  size: 200 200
  opacity: 1
  color: #c9bdab
  image-source: /images/ui/_background/window_headless
  image-border: 5
  padding: 9

  $disabled:
    color: #c9bdab88

  $dragging:
    opacity: 0.9

BlurredWindow < Window
  backdrop-blur-radius: 5

BlurredHeadlessWindow < HeadlessWindow
  backdrop-blur-radius: 5



MainWindow < Window
  anchors.centerIn: parent

BlurredMainWindow < MainWindow
  backdrop-blur-radius: 5
