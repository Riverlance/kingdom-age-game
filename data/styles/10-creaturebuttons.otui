CreatureButtonMinimapWidget < UIWidget
  size: 28 64
  &isCreatureButtonMinimapWidget: true
  // To remove button on logout
  &temporary: true
  // Match the minimap region-label zoom threshold
  &maxZoom: 0
  phantom: true

  UICreature
    id: creatureWidget
    size: 28 28
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 22
    phantom: true

  Label
    id: titleLabel
    text-wrap: true
    text-auto-resize: true
    text-align: center
    ttf-font: verdanapro-v
    ttf-font-weight: 700
    ttf-font-size: 8
    ttf-stroke: 1 #000000bb
    color: #ffffff
    anchors.top: prev.outsideBottom
    anchors.horizontalCenter: parent.horizontalCenter
    phantom: true

  UIWidget
    id: markerDot
    size: 3 3
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 29
    border: 1 #ffffff44
    background-color: #3264c8
    phantom: true

CreatureButtonIcon < UIWidget
  width: 11
  height: 11
  anchors.top: parent.top
  anchors.right: prev.outsideLeft
  margin-right: 2
  phantom: true
  on: false

  $!on:
    width: 0
    margin-right: 0

CreatureButtonProgressBar < UIProgressBar
  height: 5
  background-area-color: black
  background-padding: 1
  border: 1 black
  margin-top: 1
  margin-bottom: 0
  phantom: true

CreatureButton < UICreatureButton
  height: 20
  margin-bottom: 4

  UICreature
    id: creatureWidget
    size: 20 20
    anchors.top: parent.top
    anchors.left: parent.left
    phantom: true

  CreatureButtonIcon
    id: trackIcon
    anchors.top: prev.top
    anchors.left: prev.outsideRight
    anchors.right: none
    icon-source: /images/ui/minimap/track_mark

  Label
    id: label
    text-auto-resize: true
    anchors.top: prev.top
    anchors.left: prev.outsideRight
    anchors.right: creatureType.outsideLeft
    margin-left: 2
    margin-right: 2
    color: #888888AA
    phantom: true

  CreatureButtonIcon
    id: specialIcon
    anchors.right: parent.right

  CreatureButtonIcon
    id: emblem

  CreatureButtonIcon
    id: skull

  CreatureButtonIcon
    id: shield

  CreatureButtonIcon
    id: creatureType

  CreatureButtonProgressBar
    id: healthBar
    anchors.top: label.outsideBottom
    anchors.left: creatureWidget.outsideRight
    anchors.right: parent.right
    background-color: #ff4444
