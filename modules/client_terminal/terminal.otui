TerminalLabel < UITextEdit
  height: 14
  ttf-font: inconsolata-v
  ttf-font-weight: 700
  ttf-font-size: 12
  text-line-height: auto
  text-line-min-height: 10
  text-wrap: true
  text-auto-resize: true
  selection-color: #111416
  selection-background-color: #999999
  change-cursor-image: false
  cursor-visible: false
  editable: false
  draggable: true
  selectable: false
  focusable: false
  auto-scroll: false

UIWindow
  id: terminalWindow
  background-color: #000000
  opacity: 0.85
  clipping: true
  anchors.fill: parent
  border: 0 white
  $on:
    border: 1 black

  Label
    id: titleBar
    &loc: '${ClientTerminalTitleBar}'
    border: 1 black
    color: white
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    background-color: #ffffff11
    text-align: left
    text-offset: 4 0
    height: 18
    visible: false

  Button
    id: clearButton
    &loct: '${ClientTerminalClearButton}'
    width: 18
    icon: /images/ui/console/clear_channel
    anchors.top: prev.top
    anchors.bottom: prev.bottom
    anchors.right: parent.right
    @onClick: ClientTerminal.clear()

    $on:
      anchors.right: terminalScroll.left

  ScrollablePanel
    id: terminalBuffer
    focusable: false
    anchors.left: parent.left
    anchors.right: terminalScroll.left
    anchors.top: terminalScroll.top
    anchors.bottom: commandTextEdit.top
    layout:
      type: verticalBox
      align-bottom: true
      spacing: 0
    vertical-scrollbar: terminalScroll
    inverted-scroll: true
    margin-left: 2

  VerticalScrollBar
    id: terminalScroll
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    step: 48
    pixels-scroll: true

  UILabel
    id: commandSymbolLabel
    size: 12 12
    fixed-size: true
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    margin-left: 2
    ttf-font: inconsolata-v
    ttf-font-weight: 700
    ttf-font-size: 12
    text: >

  UITextEdit
    id: commandTextEdit
    background: #aaaaaa11
    border-color: #aaaaaa88
    &baseHeight: 14
    anchors.bottom: parent.bottom
    anchors.left: commandSymbolLabel.right
    anchors.right: terminalScroll.left
    margin-left: 1
    padding-left: 2
    ttf-font: inconsolata-v
    ttf-font-weight: 700
    ttf-font-size: 12
    text-line-spacing: 2
    selection-color: black
    selection-background-color: white
    border-width-left: 0
    border-width-top: 0
    multiline: false
    enabled: false

    $on:
      border-width-left: 1
      border-width-top: 1
      multiline: true

  ResizeBorder
    id: bottomResizeBorder
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    enabled: false

  ResizeBorder
    id: rightResizeBorder
    anchors.right: parent.right
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    enabled: false
