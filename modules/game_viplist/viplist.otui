VipListLabel < GameLabel
  margin-top: 2
  text-offset: 16 0
  ttf-stroke: 1 #000000cc
  image-rect: 0 0 12 12
  image-clip: 0 0 12 12
  image-source: /images/ui/vip_list/icons
  ttf-font: verdanapro-v
  ttf-font-weight: 700
  ttf-font-size: 11
  phantom: false

  $first:
    margin-top: 4

VipGroupList < UIWidget
  width: 156
  height: 20
  margin-top: 6

  Label
    id: group
    anchors.top: parent.top
    anchors.left: parent.left
    color: #f7f7f7
    text-auto-resize: true

  HorizontalSeparator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 2

  Panel
    id: panel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 2
    layout:
      type: verticalBox
      fit-children: true

MiniWindow
  id: vipWindow
  &loc: '${GameVipListWindowTitle}'
  icon: /images/ui/top_menu/viplist
  &save: true
  &contentMinimumHeight: 24

  MiniWindowContents
    layout: verticalBox
    padding-left: 4
    padding-right: 4
