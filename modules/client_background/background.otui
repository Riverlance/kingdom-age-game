Panel
  id: background
  image-source: /images/ui/enter_game/background/background
  image-smooth: true
  image-fixed-ratio: true
  anchors.top: topMenu.bottom
  anchors.left: parent.left
  anchors.right: parent.right
  anchors.bottom: parent.bottom
  margin-top: 1
  focusable: false

  UILabel
    id: clientVersionLabel
    //background-color: #00000099
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    text-align: center
    text-auto-resize: true
    width: 120
    padding: 2
    color: #ffffff
    ttf-font: mavenpro-v
    ttf-font-weight: 700
    ttf-font-size: 11
    ttf-stroke: 2 #000000bb

  UIWidget
    id: logo
    image-source: /images/ui/enter_game/logo_background
    image-smooth: true
    image-fixed-ratio: false
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.bottom: parent.bottom
    focusable: false

  UIParticles
    id: particles
    effect: background-effect
    anchors.fill: parent
    phantom: true
