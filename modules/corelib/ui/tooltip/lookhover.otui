TooltipLookHover < Panel
  width: 300
  background-color: #111111cc
  border-width: 1
  border-color: $uiColorBorder
  phantom: true
  focusable: false

  Label
    id: label
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin: 8
    ttf-font: opensans-v
    ttf-font-weight: 800
    ttf-font-size: 11
    text-align: center
    text-vertical-auto-resize: true
    text-wrap: true
    color: #e6db74
