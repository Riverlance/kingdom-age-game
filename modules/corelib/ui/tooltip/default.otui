TooltipDefault < Label
  ttf-font: opensans-v
  ttf-font-weight: 800
  ttf-font-size: 11
  text-align: center
  text-auto-resize: true
  padding: 4
  //background-color: #111111cc
  image-source: /images/ui/_background/window
  image-border: 1
  backdrop-blur-radius: 5
  //border-width: 1
  //border-color: $uiColorBorder
  phantom: true
  focusable: false
