Panel

  OptionCategoryLabel
    &loc: '${ClientOptionsAudioCategoryGeneral}'
    anchors.top: parent.top
    margin-top: 0

  OptionCheckBox
    id: enableAudio
    &loc: '${ClientOptionsEnableAudio}'
    &loct: '${ClientOptionsAudioTitle} (${ClientOptionsAudioActionKey})'
    @locpar: return { ClientOptionsAudioActionKey = ClientOptionsAudioActionKey }



  OptionHorizontalSeparator



  OptionCategoryLabel
    &loc: '${ClientOptionsAudioCategoryMusic}'

  OptionCheckBox
    id: enableMusic
    &loc: '${ClientOptionsEnableMusic}'
    $!first:
      margin-top: 10

  OptionLabel
    id: musicVolumeLabel
    &loc: '${ClientOptionsMusicVolumeLabel}'

  OptionScrollbar
    id: musicVolume
    minimum: 0
    maximum: 100
    symbol: %



  OptionHorizontalSeparator



  OptionCategoryLabel
    &loc: '${ClientOptionsAudioCategoryAmbient}'

  OptionCheckBox
    id: enableSoundAmbient
    &loc: '${ClientOptionsEnableSoundAmbient}'
    $!first:
      margin-top: 10

  OptionLabel
    id: soundAmbientVolumeLabel
    &loc: '${ClientOptionsSoundAmbientVolumeLabel}'

  OptionScrollbar
    id: soundAmbientVolume
    minimum: 0
    maximum: 100
    symbol: %



  OptionHorizontalSeparator



  OptionCategoryLabel
    &loc: '${ClientOptionsAudioCategoryEffect}'

  OptionCheckBox
    id: enableSoundEffect
    &loc: '${ClientOptionsEnableSoundEffect}'
    $!first:
      margin-top: 10

  OptionLabel
    id: soundEffectVolumeLabel
    &loc: '${ClientOptionsSoundEffectVolumeLabel}'

  OptionScrollbar
    id: soundEffectVolume
    minimum: 0
    maximum: 100
    symbol: %



  OptionHorizontalSeparator



  OptionCategoryLabel
    &loc: '${ClientOptionsAudioCategoryVoice}'

  OptionCheckBox
    id: enableSoundVoice
    &loc: '${ClientOptionsEnableSoundVoice}'
    $!first:
      margin-top: 10

  OptionLabel
    id: soundVoiceVolumeLabel
    &loc: '${ClientOptionsSoundVoiceVolumeLabel}'

  OptionScrollbar
    id: soundVoiceVolume
    minimum: 0
    maximum: 100
    symbol: %



  OptionHorizontalSeparator



  OptionCategoryLabel
    &loc: '${ClientOptionsAudioCategoryInterface}'

  OptionCheckBox
    id: enableSoundGui
    &loc: '${ClientOptionsEnableSoundGui}'
    $!first:
      margin-top: 10

  OptionLabel
    id: soundGuiVolumeLabel
    &loc: '${ClientOptionsSoundGuiVolumeLabel}'

  OptionScrollbar
    id: soundGuiVolume
    minimum: 0
    maximum: 100
    symbol: %
