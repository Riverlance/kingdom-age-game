Panel

  OptionCategoryLabel
    &loc: '${ClientOptionsConsoleCategoryGeneral}'
    anchors.top: parent.top
    margin-top: 0

  OptionCheckBox
    id: autoDisableChatOnSendMessage
    &loc: '${ClientOptionsAutoDisableChatOnSendMessage}'



  OptionHorizontalSeparator



  OptionCategoryLabel
    &loc: '${ClientOptionsConsoleCategorySource}'

  OptionCheckBox
    id: showInfoMessagesInConsole
    &loc: '${ClientOptionsShowInfoMessagesInConsole}'

  OptionCheckBox
    id: showEventMessagesInConsole
    &loc: '${ClientOptionsShowEventMessagesInConsole}'

  OptionCheckBox
    id: showStatusMessagesInConsole
    &loc: '${ClientOptionsShowStatusMessagesInConsole}'

  OptionCheckBox
    id: showOthersStatusMessagesInConsole
    &loc: '${ClientShowOthersStatusMessagesInConsole}'

  OptionCheckBox
    id: showPrivateMessagesInConsole
    &loc: '${ClientOptionsShowPrivateMessagesInConsole}'

  OptionCheckBox
    id: showPrivateMessagesOnScreen
    &loc: '${ClientOptionsShowPrivateMessagesOnScreen}'



  OptionHorizontalSeparator



  OptionCategoryLabel
    &loc: '${ClientOptionsConsoleCategoryInformation}'

  OptionCheckBox
    id: showTimestampsInConsole
    &loc: '${ClientOptionsShowTimestampsInConsole}'

  OptionCheckBox
    id: showLevelsInConsole
    &loc: '${ClientOptionsShowLevelsInConsole}'

  OptionCheckBox
    id: showHighlightedUnderline
    &loc: '${ClientOptionsShowHighlightedUnderline}'
