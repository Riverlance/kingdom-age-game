Panel
  OptionCategoryLabel
    &loc: '${ClientOptionsControlCategoryGeneral}'
    anchors.top: parent.top
    margin-top: 0

  OptionCheckBox
    id: classicControl
    &loc: '${ClientOptionsClassicControl}'
    &loct: '${ClientOptionsClassicControlTooltip}'
    !tooltip-type: TooltipType.textBlock
    $!first:
      margin-top: 10

  OptionCheckBox
    id: moveFullStack
    &loc: '${ClientOptionsMoveFullStack}'
    &loct: '${ClientOptionsMoveFullStackTooltip}'
    !tooltip-type: TooltipType.textBlock



  OptionHorizontalSeparator



  OptionCategoryLabel
    &loc: '${ClientOptionsControlCategoryHotkeys}'

  OptionButton
    id: hotkeysButton
    &loc: '${GameHotkeysWindowTitle}'
    &loct: '${GameHotkeysWindowTitle} (${GameHotkeysActionKey})'
    @locpar: return { GameHotkeysActionKey = GameHotkeysActionKey }
    @onClick: GameHotkeys.toggle()

  OptionLabel
    &loc: '${ClientOptionsHotkeyDelayLabel}'

  OptionScrollbar
    id: hotkeyDelay
    minimum: 30
    maximum: 250
    symbol: ms



  OptionHorizontalSeparator



  OptionCategoryLabel
    &loc: '${ClientOptionsControlCategoryWalking}'

  OptionCheckBox
    id: smartWalk
    &loc: '${ClientOptionsSmartWalk}'
    &loct: '${ClientOptionsSmartWalkTooltip}'
    !tooltip-type: TooltipType.textBlock
    $!first:
      margin-top: 10

  OptionCheckBox
    id: bouncingKeys
    &loc: '${ClientOptionsBouncingKeys}'
    &loct: '${ClientOptionsBouncingKeysTooltip}'
    !tooltip-type: TooltipType.textBlock

  OptionCheckBox
    id: cycleWalk
    &loc: '${ClientOptionsCycleWalk}'
    &loct: '${ClientOptionsCycleWalkTooltip}'
    !tooltip-type: TooltipType.textBlock

  OptionCheckBox
    id: autoChaseOverride
    &loc: '${ClientOptionsAutoChaseOverride}'
    &loct: '${ClientOptionsAutoChaseOverrideTooltip}'
    !tooltip-type: TooltipType.textBlock

  OptionLabel
    &loc: '${ClientOptionsBouncingKeysDelayScrollBarLabel}'

  OptionScrollbar
    id: bouncingKeysDelayScrollBar
    minimum: 100
    maximum: 1000
    symbol: ms

  OptionLabel
    &loc: '${ClientOptionsCycleWalkDelayLabel}'

  OptionScrollbar
    id: cycleWalkDelay
    minimum: 50
    maximum: 1000
    symbol: ms

  OptionLabel
    &loc: '${ClientOptionsWalkTurnDelayLabel}'

  OptionScrollbar
    id: walkTurnDelay
    minimum: 10
    maximum: 500
    symbol: ms

  OptionLabel
    &loc: '${ClientOptionsWalkTeleportDelayLabel}'

  OptionScrollbar
    id: walkTeleportDelay
    minimum: 50
    maximum: 500
    symbol: ms

  OptionLabel
    &loc: '${ClientOptionsWalkStairsDelayLabel}'

  OptionScrollbar
    id: walkStairsDelay
    minimum: 50
    maximum: 500
    symbol: ms
