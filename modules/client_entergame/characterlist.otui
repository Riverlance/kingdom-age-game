CharacterListHeaderColumn < TableHeaderColumn
  background-color: alpha
  color: #f2af4e
  image-source: none
  image-color: #00000000
  image-border: 0

  $disabled:
    color: #f2af4e
    opacity: 1

CharacterListCell < Label
  color: #bbbbbb
  anchors.verticalCenter: parent.verticalCenter
  ttf-font: verdanapro-v
  ttf-font-weight: 700
  ttf-font-size: 11
  ttf-stroke: 1 #000000cc
  text-auto-resize: true
  background-color: alpha
  text-offset: 4 0

CharacterListValueCell < CharacterListCell
  text-align: center
  text-auto-resize: false
  text-offset: 0 0

CharacterWidget < UIWidget
  height: 14
  image-repeated: true
  image-source: none
  &updateOnStates: |
    function(self)
      local children = self:getChildren()
      for i=1,#children do
        children[i]:setOn(self:isFocused())
      end
    end
  @onFocusChange: self:updateOnStates()
  @onSetup: |
    self:updateOnStates()
    if g_game.getFeature(GameEnterGameShowAppearance) then
      self:setHeight(76)
    end

  $focus:
    image-source: /images/ui/_background/panel_map
    image-border: 7
    //image-color: #ffffff88

  Creature
    id: outfitCreatureBox
    size: 76 76
    anchors.top: parent.top
    anchors.left: parent.left
    padding: 0
    padding-top: 8
    padding-left: 8
    creature-size: 64

    image-source: none
    image-border: 0
    border-width: 0

    @onSetup: |
      if not(g_game.getFeature(GameEnterGameShowAppearance)) then
        self:hide()
      end

  CharacterListCell
    id: name
    anchors.left: parent.left
    @onSetup: |
      if g_game.getFeature(GameEnterGameShowAppearance) then
        self:setMarginLeft(75)
      end

  Label
    id: mainCharacter
    size: 9 8
    anchors.verticalCenter: parent.verticalCenter
    anchors.left: prev.right
    margin-left: 6
    image-source: /images/ui/enter_game/maincharacter
    image-clip: 0 0 9 8
    @onSetup: |
      if not(g_game.getFeature(GameEnterGameShowAppearance)) then
        self:hide()
      end

  Label
    id: statusHidden
    size: 11 19
    anchors.verticalCenter: parent.verticalCenter
    anchors.left: prev.right
    margin-left: 6
    image-source: /images/ui/enter_game/hidden
    image-clip: 0 0 11 19
    @onSetup: |
      if not(g_game.getFeature(GameEnterGameShowAppearance)) then
        self:hide()
      end

  CharacterListValueCell
    id: level
    anchors.left: parent.left
    width: 50
    margin-left: 300
    @onSetup: |
      if not(g_game.getFeature(GameEnterGameShowAppearance)) then
        self:hide()
      end

    $on:
      color: #ffffff

  CharacterListValueCell
    id: vocation
    anchors.left: parent.left
    width: 150
    margin-left: 350
    @onSetup: |
      if not(g_game.getFeature(GameEnterGameShowAppearance)) then
        self:hide()
      end

    $on:
      color: #ffffff

  CharacterListValueCell
    id: worldName
    &baseText: '(%s)'
    @onSetup: |
      if g_game.getFeature(GameEnterGameShowAppearance) then
        self:addAnchor(AnchorLeft, 'parent', AnchorLeft)
        self:setWidth(214)
        self:setMarginLeft(500)
        self.baseText = '%s'
      else
        self:setTextAutoResize(true)
        self:setTextAlign(AlignLeft)
        self:addAnchor(AnchorRight, 'parent', AnchorRight)
        self:setMarginRight(5)
      end

    $on:
      color: #ffffff

MainWindow
  id: charactersWindow
  &loc: '${CharacterListTitle}'
  visible: false
  @onEnter: CharacterList.doLogin()
  @onEscape: CharacterList.hide(true)
  @onSetup: |
    self:updateLocale()
    g_keyboard.bindKeyPress('Up', function() self:getChildById('characterData'):focusPreviousChild(KeyboardFocusReason) end, self)
    g_keyboard.bindKeyPress('Down', function() self:getChildById('characterData'):focusNextChild(KeyboardFocusReason) end, self)
    if g_game.getFeature(GamePreviewState) then
      if g_game.getFeature(GameEnterGameShowAppearance) then
        self:setSize({width = 745, height = 430})
      else
        self:setSize({width = 350, height = 400})
      end
    else
      self:setSize({width = 250, height = 248})
    end

  Table
    id: charactersTable
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: characterListScrollBar.left
    anchors.bottom: accountStatusCaption.top
    margin-bottom: 5
    table-data: characterData
    header-column-style: CharacterListHeaderColumn

    TableHeaderRow
      id: header
      height: 20
      @onSetup: |
        if not(g_game.getFeature(GameEnterGameShowAppearance)) then
          self:hide()
        end

      CharacterListHeaderColumn
        width: 300
        &loc: '${CharacterListColumnCharacter}'

      CharacterListHeaderColumn
        width: 50
        &loc: '${CharacterListColumnLevel}'

      CharacterListHeaderColumn
        width: 150
        &loc: '${CharacterListColumnVocation}'

      CharacterListHeaderColumn
        width: 214
        &loc: '${CharacterListColumnWorld}'

  TableData
    id: characterData
    anchors.top: charactersTable.top
    anchors.left: charactersTable.left
    anchors.right: charactersTable.right
    anchors.bottom: charactersTable.bottom
    margin-top: 20
    padding: 1
    background-color: alpha
    layout: verticalBox
    vertical-scrollbar: characterListScrollBar
    @onSetup: |
      if not(g_game.getFeature(GameEnterGameShowAppearance)) then
        self:setBackgroundColor("#565656")
        self:setMarginTop(0)
      end

  VerticalScrollBar
    id: characterListScrollBar
    anchors.top: parent.top
    anchors.bottom: accountStatusCaption.top
    anchors.right: parent.right
    margin-bottom: 5
    step: 14
    pixels-scroll: true

  Label
    id: accountStatusCaption
    &loc: '${CharacterListAccountStatusLabel}:'
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: next.top
    @onSetup: |
      self:updateLocale()
      if g_game.getFeature(GameEnterGameShowAppearance) then
        self:setMarginBottom(5)
      else
        self:setMarginBottom(1)
      end

  Label
    id: accountStatusIcon
    size: 22 20
    anchors.left: parent.left
    anchors.bottom: next.bottom
    image-source: /images/ui/enter_game/premium
    image-clip: 0 0 22 20
    @onSetup: |
      if not(g_game.getFeature(GameEnterGameShowAppearance)) then
        self:hide()
      end

  Label
    id: accountStatusLabel
    &loc: '${CharacterListAccountStatusValueFree}'
    anchors.left: parent.left
    text-auto-resize: true
    @onSetup: |
      if g_game.getFeature(GameEnterGameShowAppearance) then
        self:setMarginBottom(15)
        self:setPaddingBottom(2)
        self:setTextOffset({x = 25, y = 0})
        self:addAnchor(AnchorBottom, 'next', AnchorBottom)
      else
        self:setMarginBottom(5)
        self:addAnchor(AnchorRight, 'parent', AnchorRight)
        self:addAnchor(AnchorBottom, 'separator', AnchorTop)
      end

    $on:
      color: #FF0000

  HorizontalSeparator
    id: separator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: next.top
    margin-bottom: 10

  LightButton
    id: autoReconnect
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    width: 140
    @onClick: CharacterList.toggleAutoReconnect()

  LightButton
    id: buttonOk
    &loc: '${CorelibInfoOk}'
    width: 64
    anchors.right: next.left
    anchors.bottom: parent.bottom
    margin-right: 10
    @onClick: CharacterList.doLogin()

  LightButton
    id: buttonCancel
    &loc: '${CorelibInfoCancel}'
    width: 64
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    @onClick: CharacterList.hide(true)
